<Window x:Class="EmirAntivirus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emir Antivirus" Height="800" Width="1180"
        MinHeight="680" MinWidth="980" Background="{StaticResource BackgroundBrush}"
        Foreground="#F3F6FC" WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="EMİR ANTİVİRÜS" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Windows Güvenlik Merkezi • Çevrimdışı tarama" Foreground="#9BA8BC" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UpdateButton" Content="GÜNCELLEME VAR" Click="UpdateButton_Click" Visibility="Collapsed" Margin="0,0,10,0" Padding="14,8" Background="#245C48" Foreground="White" FontWeight="Bold"/>
                <Border Background="#203B3A" CornerRadius="16" Padding="14,8">
                    <TextBlock x:Name="ProtectionStatus" Text="YEREL TARAMA HAZIR" Foreground="#75E4D0" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Tarama merkezi" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Derin tarama erişilebilen dosyaların SHA-256 özetini, dosya başlığını/türünü ve boyutunu inceler. Dosyalar çalıştırılmaz." Foreground="#AAB6C8" TextWrapping="Wrap" Margin="0,5,0,12"/>
                <WrapPanel>
                    <Button Content="Hızlı Tarama" Click="QuickScan_Click" Margin="0,0,8,8" Padding="16,10"/>
                    <Button Content="Tam Tarama" Click="FullScan_Click" Margin="0,0,8,8" Padding="16,10"/>
                    <Button Content="Derin Tarama" Click="DeepScan_Click" Margin="0,0,8,8" Padding="16,10"/>
                    <Button Content="Dosya / Klasör Seç" Click="ScanFolder_Click" Margin="0,0,8,8" Padding="16,10"/>
                    <Button Content="Ağ Taraması" Click="Network_Click" Margin="0,0,8,8" Padding="16,10"/>
                    <Button x:Name="CancelButton" Content="Taramayı İptal Et" Click="CancelScan_Click" Margin="0,0,8,8" Padding="16,10" IsEnabled="False"/>
                </WrapPanel>
                <ProgressBar x:Name="ScanProgress" Height="12" Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="StatusText" Text="Bir tarama türü seçin." Foreground="#AAB6C8" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="Kontrol edilen dosya" Foreground="#AAB6C8"/><TextBlock x:Name="FilesCountText" Text="0" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="4,0"><StackPanel><TextBlock Text="İmza eşleşmesi" Foreground="#AAB6C8"/><TextBlock x:Name="FindingsCountText" Text="0" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="4,0"><StackPanel><TextBlock Text="İnceleme uyarısı" Foreground="#AAB6C8"/><TextBlock x:Name="ReviewCountText" Text="0" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
            <Border Grid.Column="3" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="12" Margin="8,0,0,0"><StackPanel><TextBlock Text="Erişilemeyen öğe" Foreground="#AAB6C8"/><TextBlock x:Name="SkippedCountText" Text="0" FontSize="22" FontWeight="Bold"/></StackPanel></Border>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Tarama etkinliği" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ListView x:Name="ActivityList" Background="Transparent" BorderThickness="0" Foreground="#E6ECF5">
                    <ListView.View><GridView>
                        <GridViewColumn Header="Saat" DisplayMemberBinding="{Binding Time}" Width="90"/>
                        <GridViewColumn Header="İşlem" DisplayMemberBinding="{Binding Action}" Width="180"/>
                        <GridViewColumn Header="Ayrıntı" DisplayMemberBinding="{Binding Details}" Width="700"/>
                    </GridView></ListView.View>
                </ListView>
            </DockPanel>
        </Border>
        <TextBlock Grid.Row="4" Text="Bilgi: İmza veritabanı henüz boş olabilir. Uyarılar kesin zararlı tespiti değildir; elle kontrol gerektirir. Bu uygulama Microsoft Defender'ın yerine geçmez." Foreground="#8290A5" TextWrapping="Wrap" Margin="2,12,0,0"/>
    </Grid>
</Window>